# --- Zorunlu ---
# En az 32 karakter, rastgele üretin: openssl rand -base64 48
JWT_SECRET=

# Veritabanında hiç kullanıcı yoksa ilk açılışta bu admin hesabı oluşturulur (şifre 8-72 karakter)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Veritabanı ---
# sqlite (varsayılan) veya postgres
DB_DRIVER=sqlite
# SQLite için dosya yolu, PostgreSQL için bağlantı adresi
DATABASE_URL=odeme_sistemi.db
# Yalnızca docker-compose için
POSTGRES_PASSWORD=

# --- İsteğe bağlı ---
PORT=8080
# text veya json
LOG_FORMAT=text
# Uygulama güvenilir bir ters proxy (nginx, Caddy, yük dengeleyici) arkasındaysa true yapın
TRUST_PROXY=false
# Ödeme olaylarının gönderileceği adres; ayarlıysa WEBHOOK_SECRET (en az 32 karakter) zorunlu
WEBHOOK_URL=
WEBHOOK_SECRET=
